  "fixed_sql": [
    {
      "name": "evidence_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"evidence_entries\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"captured_at_millis\" INTEGER NOT NULL, \"sensitivity\" TEXT NOT NULL, \"source_kind\" TEXT NULL, \"source_locator\" TEXT NULL, \"source_account_ref\" TEXT NULL, \"integrity\" TEXT NULL, \"excerpt\" TEXT NULL, \"claim_kind\" TEXT NULL, \"claim_counterparty\" TEXT NULL, \"claim_by_millis\" INTEGER NULL, \"claim_source_quote\" TEXT NULL, \"produced_by_id\" TEXT NULL, \"produced_by_version\" TEXT NULL, \"confidence_value\" REAL NULL, \"confidence_basis\" TEXT NULL, \"confidence_method_id\" TEXT NULL, \"confidence_method_version\" TEXT NULL, \"confidence_under\" TEXT NULL, \"confidence_computed_at_millis\" INTEGER NULL, \"assertion_kind\" TEXT NULL, \"about_evidence_id\" TEXT NULL REFERENCES evidence_entries (id), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "loop_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"loop_records\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"state\" TEXT NOT NULL, \"basis_evidence_id\" TEXT NOT NULL REFERENCES evidence_entries (id), \"commitment_id\" TEXT NULL, \"suggestion_id\" TEXT NULL, \"waiting_on\" TEXT NULL, \"waiting_since_millis\" INTEGER NULL, \"resolved_at_millis\" INTEGER NULL, \"abandon_reason\" TEXT NULL, \"suppressed_until_millis\" INTEGER NULL, \"pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pinned\" IN (0, 1)), \"sensitivity\" TEXT NOT NULL, \"created_at_millis\" INTEGER NOT NULL, \"updated_at_millis\" INTEGER NOT NULL, \"state_changed_at_millis\" INTEGER NOT NULL, \"schema_version\" INTEGER NOT NULL DEFAULT 1, \"revision\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "loop_event_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"loop_event_records\" (\"loop_id\" TEXT NOT NULL REFERENCES loop_records (id), \"sequence\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL, \"actor\" TEXT NOT NULL, \"at_millis\" INTEGER NOT NULL, \"from_state\" TEXT NULL, \"to_state\" TEXT NULL, \"abandon_reason\" TEXT NULL, \"evidence_id\" TEXT NULL REFERENCES evidence_entries (id), PRIMARY KEY (\"loop_id\", \"sequence\"));"
        }
      ]
    },
    {
      "name": "loop_evidence_links",
      "sql": [
